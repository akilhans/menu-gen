{
  "name": "menu-gen",
  "version": "1.0.0",
  "private": true,
  "description": "QR menu generation platform — restaurants create digital menus and share them via QR codes.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace apps/api",
    "build:web": "npm run build --workspace apps/web",
    "start:api": "npm run start --workspace apps/api",
    "start:web": "npm run start --workspace apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "seed": "npm run seed --workspace apps/api",
    "seed:nur": "npm run seed:nur --workspace apps/api"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
